          },
          "actions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "enum": [
                    "ArrowLeft",
                    "ArrowRight",
                    "ArrowUp",
                    "ArrowDown",
                    "Space",
                    "Enter",
                    "KeyA",
                    "KeyD",
                    "KeyW",
                    "KeyS"
                  ]
                },
                "frames": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120
