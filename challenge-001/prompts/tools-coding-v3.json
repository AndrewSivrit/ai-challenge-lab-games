    "function": {
      "name": "browser_check",
      "description": "Open a workspace HTML game in isolated Chromium, capture feedback and PNG; actions hold an optional key for frames of 16 ms; each call starts fresh.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
